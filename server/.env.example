# Server Environment Variables — copy to server/.env and fill in real values.
PORT=3001
NODE_ENV=development

# MongoDB Connection (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/nocturne

# JWT Secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a DIFFERENT value for each, never commit real values.
JWT_ACCESS_SECRET=change-me-generate-with-crypto-randombytes
JWT_REFRESH_SECRET=change-me-generate-with-crypto-randombytes

# Client URL (for CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# --- Photo storage (Cloudinary — wired up) ---
# Sign up at https://cloudinary.com, then set these three. The backend
# uploads via POST /api/users/me/photos/upload and stores the CDN URL.
# (CLOUDINARY_URL works as an alternative; explicit vars take precedence.
#  Delete it if it still holds a placeholder value.)
# CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
